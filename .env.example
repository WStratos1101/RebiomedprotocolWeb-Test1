# Rebiomed Protocol self-hosting configuration
NODE_ENV=production
PORT=3000

# Generic local session settings. Do not reuse these examples in production.
APP_ID=rebiomed-local
SESSION_SECRET=replace-with-a-long-random-session-secret

# MySQL connection used by the app and migration service.
MYSQL_DATABASE=rebiomed
MYSQL_USER=rebiomed
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
DATABASE_URL=mysql://rebiomed:replace-with-a-database-password@db:3306/rebiomed

# Required for account registration and controlled password viewing.
# Use a long private code and keep it outside Git.
REBIOMED_PASSWORD_VAULT_KEY=replace-with-a-long-private-vault-code

# Optional: leave these unset for standalone email-only authentication.
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
# MANUS_OAUTH_API_URL=
# MANUS_OAUTH_PORTAL_URL=
# MANUS_API_URL=
# MANUS_API_KEY=
